{
  "**/*.{json,md,html}": ["pnpm --filter frontend exec prettier --write"],
  "packages/frontend/**/*.{js,ts,tsx}": [
    "pnpm --filter frontend exec prettier --write",
    "pnpm --filter frontend exec eslint --fix"
  ],
  "packages/backend-go/**/*.go": ["gofmt -w"],
  "**/*.css": "stylelint --fix",
  "**/*.scss": [
    "pnpm --filter frontend exec prettier --write",
    "stylelint --fix --customSyntax=post-scss"
  ]
}
