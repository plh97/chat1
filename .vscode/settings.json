{
  "eslint.run": "onSave",
  "editor.formatOnSave": true,
  "prettier.enable": true,
  "eslint.format.enable": true,
  "git.ignoreLimitWarning": true,
  "cSpell.words": [
    "chakra",
    "cmdk",
    "godoc",
    "plhh",
    "unplugin",
    "usehooks",
    "virtua",
    "VITE",
    "Xmark"
  ],
  "make-runner.env": {
    "development": {
      "AWS_PROFILE": "development",
      "RAILS_ENV": "development",
      "ROLE": "admin",
      "ENABLE_MFA": false
    },
    "staging": {
      "AWS_PROFILE": "staging",
      "RAILS_ENV": "staging",
      "ROLE": "user",
      "ENABLE_MFA": true
    },
    "none": {}
  }
}
