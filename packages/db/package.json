{
  "name": "db",
  "scripts": {
    "prisma:inline": "cp ./node_modules/.prisma/client/*.js ./node_modules/@prisma/client",
    "db:studio": "prisma studio",
    "db:push": "prisma db push --skip-generate",
    "dev": "prisma generate",
    "postinstall": "prisma generate && prisma:inline"
  },
  "devDependencies": {
    "@types/node": "22.8.5",
    "prisma": "5.21.1"
  },
  "dependencies": {
    "@prisma/client": "5.21.1"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
