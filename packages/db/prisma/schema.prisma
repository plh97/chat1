generator client {
  provider = "prisma-client-js"
  // output = "../src/db"
}

datasource db {
  // provider = "postgresql"
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum IChannelType {
  // PRIVATE: 0,
  // GROUP = 1,
  PRIVATE @map("0")
  GROUP   @map("1")
}

enum IContentType {
  // TEXT_MESSAGE = 0,
  // MEDIA_MESSAGE = 1,
  // SYSTEM_MESSAGE = 2,
  // CALL_MESSAGE = 3,
  // READ_MESSAGE = 4,
  // RECALL_MESSAGE = 5,
  TEXT_MESSAGE   @map("0")
  MEDIA_MESSAGE  @map("1")
  SYSTEM_MESSAGE @map("2")
  CALL_MESSAGE   @map("3")
  READ_MESSAGE   @map("4")
  RECALL_MESSAGE @map("5")
}

model User1 {
  id          String   @id @default(uuid()) @map("_id")
  userId      String[] @unique
  successor   User1[]  @relation("BlogOwnerHistory", fields: [userId], references: [id])
  predecessor User1[]  @relation("BlogOwnerHistory", fields: [userId], references: [id])
}

model User {
  id          String    @id @default(uuid()) @map("_id")
  createdAt   DateTime  @default(now())
  username    String    @unique
  password    String
  bio         String?
  qq          String?
  wechat      String?
  github      String?
  permission  String?
  image       String    @default("")
  message     Message[]
  // friend
  friendId    String[]
  friend      User[]    @relation("friend", fields: [friendId], references: [id])
  predecessor User[]    @relation("friend", fields: [friendId], references: [id])
  // 
  room        Room?     @relation(fields: [roomId], references: [id])
  roomId      String?
}

model Room {
  id          String       @id @default(uuid()) @map("_id")
  name        String
  image       String?
  channelType IChannelType @default(GROUP)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
  member      String[]
  admin       String[]
  readSeq     Json         @default("{}")
  message     Message[]
  creater     String

  User User[]
}

model Message {
  id           String        @id @default(uuid()) @map("_id")
  createdAt    DateTime      @default(now())
  seq          Int
  contentType  IContentType  @default(TEXT_MESSAGE)
  channelId    String
  textMessage  TextMessage?
  mediaMessage MediaMessage?
  readMessage  ReadMessage?
  room         Room?         @relation(fields: [roomId], onDelete: Cascade, references: [id])
  user         User?          @relation(fields: [userId], onDelete: Cascade, references: [id])

  roomId String?
  userId String?

  @@index([roomId])
  @@index([userId])
}

type ReadMessage {
  operator    String
  lastReadSeq Int
}

type MediaMessage {
  url       String
  width     Float?
  height    Float?
  thumbnail String?
  extension String
  name      String
  size      Float
  fileType  String
  duration  String?
}

type TextMessage {
  text    String
  methion String[]
}
