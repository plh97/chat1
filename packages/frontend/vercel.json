{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-c.plhh.org/api/:path*"
    },
    {
      "source": "/ws",
      "destination": "wss://api-c.plhh.org/ws"
    },
    {
      "source": "/((?!ws/).*)",
      "destination": "/index.html"
    }
  ]
}
