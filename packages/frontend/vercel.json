{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://c-api.plhh.org/:path*"
    },
    {
      "source": "/((?!ws/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ws/:path*",
      "destination": "wss://c-api.plhh.org/ws/:path*"
    }
  ]
}
