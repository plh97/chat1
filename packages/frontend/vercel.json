{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-c.plhh.org/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "http://45.76.110.22:8000/ws/:path*"
    },
    {
      "source": "/((?!ws/).*)",
      "destination": "/index.html"
    }
  ]
}
