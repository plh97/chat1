{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "api-c.plhh.org"
        }
      ],
      "destination": "http://45.76.110.22:8000/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://45.76.110.22:8000/:path*"
    },
    {
      "source": "/((?!ws/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ws/:path*",
      "destination": "ws://45.76.110.22:8001/ws/:path*"
    }
  ]
}
