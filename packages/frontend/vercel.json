{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://45.76.110.22:8000/api/:path*"
    },
    {
      "source": "/((?!ws/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ws/:path*",
      "destination": "ws://45.76.110.22:8001/ws/:path*"
    }
  ]
}
