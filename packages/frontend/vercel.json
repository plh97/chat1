{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://18.141.225.236/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "http://18.141.225.236/ws/:path*"
    },
    {
      "source": "/((?!ws/).*)",
      "destination": "/index.html"
    }
  ]
}
