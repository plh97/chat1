{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.4
          }
        ],
        "categories:accessibility": "off",
        "categories:best-practices": "off",
        "categories:seo": "off",
        "categories:pwa": "off",
        "csp-xss": "off",
        "errors-in-console": "off",
        "installable-manifest": "off",
        "landmark-one-main": "off",
        "maskable-icon": "off",
        "splash-screen": "off",
        "themed-omnibox": "off",
        "total-byte-weight": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
